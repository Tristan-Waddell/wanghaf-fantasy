# PostgreSQL connection string used by the application and setup script.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wanghaf_fantasy

# Set this to true only when PostgreSQL requires TLS (common on hosted databases).
DATABASE_SSL=false

# Optional: use a DNS hostname for connection/TLS when DATABASE_URL contains an IP.
# The hostname must match the database server's TLS certificate.
DATABASE_HOST_OVERRIDE=

# Optional local testing override. Set to a week number to unlock only that week.
PICK_TEST_WEEK=
